#include <windows.h>

// Embed the asInvoker manifest (load-like-native, no UAC)
1 RT_MANIFEST "stub_gen.manifest"

// App icon (matches the app's runner icon so the portable looks native)
1 ICON "app_icon.ico"

// Version info so the file isn't "blank" in Explorer properties
VS_VERSION_INFO VERSIONINFO
 FILEVERSION {{VERCSV}}
 PRODUCTVERSION {{VERCSV}}
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "{{COMPANY}}"
            VALUE "FileDescription",  "{{NAME}}"
            VALUE "FileVersion",      "{{VERSION}}.0"
            VALUE "InternalName",     "{{IDENT}}"
            VALUE "OriginalFilename", "{{OUTNAME}}"
            VALUE "ProductName",      "{{NAME}}"
            VALUE "ProductVersion",   "{{VERSION}}.0"
            VALUE "LegalCopyright",   "{{COMPANY}}"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
