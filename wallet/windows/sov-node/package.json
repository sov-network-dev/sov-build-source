{
  "name": "sov-node",
  "version": "1.0.0",
  "description": "SOV Network Node — sovereign citizen infrastructure software",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "watchdog": "node src/watchdog/watchdog.js",
    "dev": "NODE_ENV=development node src/index.js",
    "test": "node scripts/run_tests.js",
    "sign": "node scripts/sign_release.js",
    "obfuscate": "node scripts/obfuscate.js",
    "build:release": "node scripts/build_release.js",
    "build:win": "node scripts/build_release.js --platform=win && node installer/windows/build.js",
    "build:lin": "node scripts/build_release.js --platform=linux && snapcraft",
    "build:mac": "node scripts/build_release.js --platform=macos && node installer/macos/build.js"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.10.0",
    "better-sqlite3-multiple-ciphers": "^12.9.0",
    "bip39": "^3.1.0",
    "bittorrent-dht": "^11.0.12",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "nat-api": "^0.3.1",
    "nat-upnp": "^1.1.1",
    "node-forge": "^1.3.1",
    "node-schedule": "^2.1.1",
    "shamir-secret-sharing": "^0.0.4",
    "stun": "^2.1.0",
    "systray2": "^2.1.4",
    "tweetnacl": "^1.0.3",
    "winston": "^3.11.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "javascript-obfuscator": "^5.4.2",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "targets": [
      "node18-win-x64",
      "node18-linux-x64",
      "node18-linux-arm64",
      "node18-macos-x64"
    ],
    "outputPath": "dist",
    "assets": [
      "src/**/*",
      "keys/network_public_key.pem"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "UNLICENSED"
}
