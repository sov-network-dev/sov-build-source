# ─────────────────────────────────────────────────────────────────────────────
# SOV Node — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env (Linux/macOS) or %APPDATA%\sov-node\.env (Windows)
# Fill in the values before starting your node for the first time.
#
# The node generates a default .env on first run if this template is present.
# Most values have sensible defaults and do not need to be changed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Network ────────────────────────────────────────────────────────────────────
# Port for citizen apps to connect (default 443 = standard HTTPS, bypasses firewalls)
SOV_PORT=443

# Port for node-to-node peer mesh connections
SYNC_PORT=7771

# Your relay ID (optional — auto-generated from Node ID if not set)
# RELAY_ID=NODE1

# ── Bootstrap ─────────────────────────────────────────────────────────────────
# Comma-separated list of seed node addresses for first connection.
# The live SOV VPS nodes are the initial seeds. After first connection,
# your node learns thousands of citizen nodes and no longer needs these.
BOOTSTRAP_SEEDS=79.72.71.101:7771,136.119.11.49:7771,35.192.130.190:7771

# ── Data directory ────────────────────────────────────────────────────────────
# Where the node stores its database, keys, and logs.
# Default: ~/.sov-node (Linux/macOS) or %APPDATA%\sov-node (Windows)
# SOV_DATA_DIR=/path/to/custom/data/directory

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: error | warn | info | debug
LOG_LEVEL=info

# ── Security (loaded at runtime — never hardcoded in source) ───────────────────
# Message types that skip Ed25519 signature verification (bootstrap messages only).
# WARNING: Do not change unless you understand the security implications.
EXEMPT_TYPES=PEER_HELLO,NODE_ANNOUNCE

# Spend lock quorum timeout (ms) — time to wait for peer responses before deciding
SSP_QUORUM_TIMEOUT_MS=500

# Merkle root comparison interval (ms) — how often to check for ledger drift with peers
SSP_MERKLE_INTERVAL_MS=10000

# ── Operator ───────────────────────────────────────────────────────────────────
# OPERATOR_SOVEREIGN_ID: your Sovereign ID — the citizen wallet that owns this node.
# This is how the network knows whose wallet to pay for your proof of service.
# Enrol on the SOV phone app, then copy your ID from Profile.
# Form: SOV- followed by 16 hex characters, e.g. SOV-1A2B3C4D5E6F7A8B
#
# A NEW node refuses to start until this is set — deliberately. Left blank, you
# would serve citizens and earn nothing, with nothing on screen to tell you.
# Already-running nodes keep working and simply warn, so upgrades stay safe.
# Copy your ID here, then restart the node. Do the same on every node you run.
#   OPERATOR_SOVEREIGN_ID=SOV-1A2B3C4D5E6F7A8B     <- example only, not a real ID
OPERATOR_SOVEREIGN_ID=

# ── LiveKit (voice/video calls — optional) ────────────────────────────────────
# Only needed if this node also runs a LiveKit media server (S15 feature).
# Leave blank if you are not running LiveKit on this machine.
# LIVEKIT_API_KEY=sov_api_key
# LIVEKIT_API_SECRET=your_generated_secret
# LIVEKIT_URL=wss://your-node-ip:7880
